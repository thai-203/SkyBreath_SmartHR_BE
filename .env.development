# Application
NODE_ENV=development
APP_NAME=SkyBreath_SmartHR
APP_PORT=3000
APP_HOST=localhost
API_PREFIX=api
API_VERSION=v1
FRONTEND_URL=http://localhost:3001

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=12345
DB_DATABASE=smarthr_db
DB_SYNCHRONIZE=true
DB_LOGGING=true

# JWT
JWT_SECRET=dev-secret-key-change-in-production-32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-key-change-32chars
JWT_REFRESH_EXPIRES_IN=7d

# File Upload
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760

# Swagger
SWAGGER_ENABLED=true

# Email Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=wanggchouu@gmail.com
MAIL_PASSWORD=qbjp rkal mcea bvtn

# Redis Cache
REDIS_HOST='127.0.0.1'
REDIS_PORT=6379
